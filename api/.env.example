# =============================================================================
# Fortify API — variáveis de ambiente
# Copie para api/.env:  Copy-Item .env.example .env   (PowerShell, dentro de api/)
# =============================================================================

# --- Banco de dados (obrigatório) ---
# Local com Docker Compose:
DATABASE_URL=postgresql://fortify:fortify@localhost:5432/fortify
# Prisma migrations/seed (local = mesmo valor; Supabase = session pooler ou direct)
DIRECT_URL=postgresql://fortify:fortify@localhost:5432/fortify

# --- Servidor ---
API_PORT=3001
NODE_ENV=development
# Atrás de nginx/Cloudflare: use TRUST_PROXY=1 para rate limit por IP real
TRUST_PROXY=

# --- Rate limit (proteção contra abuso) ---
# Desabilitar em dev local: RATE_LIMIT_ENABLED=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_MODERATE_MAX=30
RATE_LIMIT_SIGNATURE_OTP_MAX=5
RATE_LIMIT_UPLOAD_MAX=20

# --- Autenticação JWT (obrigatório em produção) ---
JWT_SECRET=change-me-use-openssl-rand-hex-32
# Access token (Bearer) — curto; renovado via cookie HttpOnly
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token (cookie) — longo
JWT_REFRESH_EXPIRES_IN=30d
# Legado: usado só se JWT_ACCESS_EXPIRES_IN não estiver definido
JWT_EXPIRES_IN=15m

# --- URLs públicas ---
# App web (links de assinatura, redefinição de senha)
WEB_URL=http://localhost:5173
# API pública (comprovantes/documentos em e-mails de assinatura)
PUBLIC_API_URL=http://localhost:3001/api
# Alias opcional de PUBLIC_API_URL
API_PUBLIC_URL=
# CORS — origens permitidas (vírgula para múltiplas)
CORS_ORIGIN=http://localhost:5173

# --- E-mail (SMTP) ---
# Sem SMTP_HOST o envio cai em mock no console ([MOCK EMAIL]).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Fortify <seu-email@gmail.com>
# Alternativa ao SMTP_FROM (só o e-mail)
MAIL_FROM=

# --- Integrações em desenvolvimento ---
# Loga envio WhatsApp no console em vez de integração real
WHATSAPP_MOCK=true
# Gera PDF de assinatura mock (evita Playwright/Chromium no dev)
SIGNATURE_PDF_MOCK=true
# Fluxo PDF-first na assinatura (false = HTML-first legado)
SIGNATURE_PDF_FIRST=true
# OTP na assinatura pública (false = desabilita OTP em dev)
SIGNATURE_OTP_REQUIRED=true

# --- Arquivos ---
UPLOAD_DIR=./uploads

# --- LGPD / legal ---
DPO_EMAIL=privacidade@fortify.local
LEGAL_TERMS_VERSION=1.0
LEGAL_PRIVACY_VERSION=1.0

# --- Obras / ordens de compra ---
# Valor (R$) a partir do qual O.C. exige aprovação manual de ADMIN/SUPER_ADMIN
PO_APPROVAL_THRESHOLD=5000
